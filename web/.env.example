# --- Sanity (public, safe to expose) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=rnc8k23w
NEXT_PUBLIC_SANITY_DATASET=production
# URL of the deployed Studio (used for click-to-edit links in Visual Editing)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# --- Sanity (secret, server only) ---
# Viewer token: enables draft previews / Presentation tool (sanity.io/manage -> API -> Tokens)
SANITY_API_READ_TOKEN=
# Editor token: lets the contact form archive submissions in the Studio "Contact Inbox" (optional)
SANITY_API_WRITE_TOKEN=

# --- Contact form email (Resend, free tier: 3,000 emails/month) ---
# 1. Create a free account at https://resend.com and generate an API key
# 2. Without a verified domain, Resend only delivers to the email you signed up with:
#    set CONTACT_TO_EMAIL to that same address.
RESEND_API_KEY=
CONTACT_TO_EMAIL=huguesishema@gmail.com
# Sender. "onboarding@resend.dev" works without a verified domain.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
